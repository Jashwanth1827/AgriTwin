# ---------------------------------------------------------------------------
# AgriTwin environment template
#
# Copy to `.env` for local development or Docker Compose:
#     cp .env.example .env
#
# Every value below is read by `backend/app/core/config.py`.  The defaults in
# this file are safe for local demos only.  For any real deployment, set a
# unique JWT secret, a strong database password and DEMO_MODE=false.
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------- app
APP_NAME=AgriTwin
APP_VERSION=1.0.0
ENVIRONMENT=development        # development | test | production
DEBUG=false
DEMO_MODE=true                 # true loads clearly-labelled demo farms/buyers/offers
LOG_LEVEL=INFO

# -------------------------------------------------------------- database
# Local default (SQLite) — uncomment to be explicit:
# DATABASE_URL=sqlite:///./backend/agritwin.db
#
# Docker Compose overrides this automatically. For a manual PostgreSQL run:
# DATABASE_URL=postgresql+psycopg://agritwin:change-me@localhost:5432/agritwin
#
# Compose-only variables:
POSTGRES_DB=agritwin
POSTGRES_USER=agritwin
POSTGRES_PASSWORD=agritwin_dev_password
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ------------------------------------------------------------------ auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# --------------------------------------------------------------- uploads
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=8
MAX_IMAGE_DIMENSION=4096
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp

# -------------------------------------------------------------- ML paths
# Leave unset to use the bundled artifacts under backend/app/ml/artifacts.
# CROP_HEALTH_ARTIFACT_DIR=./backend/app/ml/artifacts/crop_health
# YIELD_ARTIFACT_DIR=./backend/app/ml/artifacts/yield_prediction
# MARKET_ARTIFACT_DIR=./backend/app/ml/artifacts/market_forecasting
CROP_HEALTH_CONFIDENCE_THRESHOLD=0.55

# ------------------------------------------------------------- providers
# Public, keyless APIs. Set to `disabled` for fully offline operation.
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_PROVIDER=open-meteo
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
ROUTING_PROVIDER=osrm           # osrm | geodesic
OSRM_BASE_URL=https://router.project-osrm.org
HTTP_TIMEOUT_SECONDS=10
EXTERNAL_CACHE_TTL_SECONDS=900

# ---------------------------------------------------------- live market rates
# auto = official Agmarknet/data.gov.in when DATA_GOV_API_KEY is set,
#        otherwise keyless Mandi Price API mirror (five states only).
# Register for a free data.gov.in API key if you want nationwide live rates.
LIVE_MARKET_PROVIDER=auto
# DATA_GOV_API_KEY=
DATA_GOV_BASE_URL=https://api.data.gov.in/resource
# Primary: Current Daily Price of Various Commodities from Various Markets (Mandi)
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# Companion: Variety-wise Daily Market Prices Data of Commodity (sorted by date desc)
DATA_GOV_VARIETY_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
LIVE_MARKET_USE_VARIETY_SOURCE=true
DATA_GOV_PAGE_SIZE=200
LIVE_MARKET_TIMEOUT_SECONDS=30
MANDI_API_BASE_URL=https://mandi-api.onrender.com/v1

# ------------------------------------------------------------- transport
DEFAULT_COST_PER_KM_INR=18
DEFAULT_FIXED_COST_INR=350
DEFAULT_LOADING_COST_INR=120
DEFAULT_UNLOADING_COST_INR=120
DEFAULT_VEHICLE_CAPACITY_QUINTALS=100
GEODESIC_DETOUR_FACTOR=1.25
SELLING_COMMISSION_PCT=0.01
OTHER_SELLING_COST_PER_QUINTAL=5

# ------------------------------------------------------------ rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=20

# ------------------------------------------------------------------ cors
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------ seed
SEED_DEMO_USER_EMAIL=demo@agritwin.in
SEED_DEMO_USER_PASSWORD=Demo@12345
